        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^24.19.2",
        "colorjs.io": "^0.7.1",
        "eslint": "^9.39.5",
        "eslint-plugin-better-tailwindcss": "^4.9.1",
        "jsdom": "^30.0.0",
        "ng-packagr": "^22.2.0",
        "playwright": "^1.64.1",
        "postcss": "^8.5.30",
        "storybook": "^10.6.2",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.2",
