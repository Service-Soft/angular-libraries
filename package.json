{
    "name": "angular-libraries",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test && npm run test:workspace",
        "test:workspace": "vitest run --config tests/vitest.config.mts",
        "storybook": "ng run ui:storybook",
        "build-storybook": "ng run ui:build-storybook",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --max-warnings=0 --fix"
    },
    "private": true,
    "packageManager": "npm@11.19.0",
    "dependencies": {
        "@angular/common": "^22.2.5",
        "@angular/compiler": "^22.2.5",
        "@angular/core": "^22.2.5",
        "@angular/forms": "^22.2.5",
        "@angular/platform-browser": "^22.2.5",
        "@angular/router": "^22.2.5",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^22.2.5",
        "@angular/aria": "^22.2.5",
        "@angular/build": "^22.2.5",
        "@angular/cli": "^22.2.5",
        "@angular/compiler-cli": "^22.2.5",
        "@angular/platform-browser-dynamic": "^22.2.5",
        "@angular/platform-server": "22.2.5",
        "@angular/service-worker": "^22.2.5",
        "@angular/ssr": "^22.2.6",
        "@axe-core/playwright": "^4.13.0",
