        "showcase": {
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "configurations": {
                        "development": {
                            "extractLicenses": false,
                            "optimization": false,
                            "sourceMap": true
                        },
                        "production": {
                            "budgets": [
                                {
                                    "maximumError": "1MB",
                                    "maximumWarning": "500kB",
                                    "type": "initial"
                                },
                                {
                                    "maximumError": "8kB",
                                    "maximumWarning": "4kB",
                                    "type": "anyComponentStyle"
                                }
                            ],
                            "outputHashing": "all"
                        }
                    },
                    "defaultConfiguration": "production",
                    "options": {
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "projects/showcase/public"
                            }
                        ],
                        "browser": "projects/showcase/src/main.ts",
                        "outputMode": "static",
                        "server": "projects/showcase/src/main.server.ts",
                        "styles": ["projects/showcase/src/styles.css"],
                        "tsConfig": "projects/showcase/tsconfig.app.json"
                    }
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "development": {
                            "buildTarget": "showcase:build:development"
                        },
                        "production": {
                            "buildTarget": "showcase:build:production"
                        }
                    },
                    "defaultConfiguration": "development"
                }
            },
            "prefix": "app",
            "projectType": "application",
            "root": "projects/showcase",
            "schematics": {
                "@schematics/angular:class": {
                    "skipTests": true
                },
                "@schematics/angular:component": {
                    "skipTests": true
                },
                "@schematics/angular:directive": {
                    "skipTests": true
                },
                "@schematics/angular:guard": {
                    "skipTests": true
                },
                "@schematics/angular:interceptor": {
                    "skipTests": true
                },
                "@schematics/angular:pipe": {
                    "skipTests": true
                },
                "@schematics/angular:resolver": {
                    "skipTests": true
                },
                "@schematics/angular:service": {
                    "skipTests": true
                }
            },
            "sourceRoot": "projects/showcase/src"
        },
        "testing": {
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "configurations": {
                        "development": {
                            "tsConfig": "projects/testing/tsconfig.lib.json"
                        },
                        "production": {
                            "tsConfig": "projects/testing/tsconfig.lib.prod.json"
                        }
                    },
                    "defaultConfiguration": "production"
                }
            },
            "prefix": "lib",
            "projectType": "library",
            "root": "projects/testing",
            "sourceRoot": "projects/testing"
        },
        "ui": {
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "configurations": {
                        "development": {
                            "tsConfig": "projects/ui/tsconfig.lib.json"
                        },
                        "production": {
                            "tsConfig": "projects/ui/tsconfig.lib.prod.json"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "build-storybook": {
                    "builder": "@storybook/angular:build-storybook",
                    "options": {
                        "browserTarget": "ui:build",
                        "compodoc": false,
                        "configDir": "projects/ui/.storybook",
                        "experimentalZoneless": true,
                        "outputDir": "dist/storybook/ui",
                        "styles": ["projects/ui/.storybook/styles.css"],
                        "tsConfig": "projects/ui/.storybook/tsconfig.json"
                    }
                },
                "storybook": {
                    "builder": "@storybook/angular:start-storybook",
                    "options": {
                        "browserTarget": "ui:build",
                        "compodoc": false,
                        "configDir": "projects/ui/.storybook",
                        "experimentalZoneless": true,
                        "port": 6006,
                        "styles": ["projects/ui/.storybook/styles.css"],
                        "tsConfig": "projects/ui/.storybook/tsconfig.json"
                    }
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "setupFiles": ["projects/ui/test-setup.ts"],
                        "tsConfig": "projects/ui/tsconfig.spec.json"
                    }
                }
            },
            "prefix": "ui",
            "projectType": "library",
            "root": "projects/ui",
            "sourceRoot": "projects/ui"
        }
    },
    "schematics": {
        "@schematics/angular:component": {
            "type": "component"
        },
        "@schematics/angular:directive": {
            "type": "directive"
        },
        "@schematics/angular:guard": {
            "typeSeparator": "."
        },
        "@schematics/angular:interceptor": {
            "typeSeparator": "."
        },
        "@schematics/angular:pipe": {
            "typeSeparator": "."
        },
        "@schematics/angular:resolver": {
            "typeSeparator": "."
        },
        "@schematics/angular:service": {
            "type": "service"
        }
    },
    "version": 1
}