            "@service-soft/ngx-pwa": ["./projects/ngx-pwa/src/public-api.ts"],
            "@service-soft/ngx-pwa/*": ["./projects/ngx-pwa/*/public-api.ts"],
            "@service-soft/ngx-tracking": ["./projects/ngx-tracking/src/public-api.ts"],
            "@service-soft/ngx-tracking/*": ["./projects/ngx-tracking/*/public-api.ts"],
            "@service-soft/ui": ["./projects/ui/src/public-api.ts"],
            "@service-soft/ui/*": ["./projects/ui/*/public-api.ts"],
            "testing": ["./projects/testing/src/public-api.ts"],
            "testing/*": ["./projects/testing/*/public-api.ts"]
