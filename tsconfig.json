/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
    "angularCompilerOptions": {
        "enableI18nLegacyMessageIdFormat": false,
        "strictInjectionParameters": true,
        "strictInputAccessModifiers": true
    },
    "compileOnSave": false,
    "compilerOptions": {
        "experimentalDecorators": true,
        "importHelpers": true,
        "isolatedModules": true,
        "module": "preserve",
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noPropertyAccessFromIndexSignature": true,
        "paths": {
            "@service-soft/ngx-auth": ["./projects/ngx-auth/src/public-api.ts"],
            "@service-soft/ngx-auth/*": ["./projects/ngx-auth/*/public-api.ts"],
            "@service-soft/ngx-change-sets": ["./projects/ngx-change-sets/src/public-api.ts"],
            "@service-soft/ngx-change-sets/*": ["./projects/ngx-change-sets/*/public-api.ts"],
            "@service-soft/ngx-ecommerce": ["./projects/ngx-ecommerce/src/public-api.ts"],
